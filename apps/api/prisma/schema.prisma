// ====================================================================================
// DATABASE CONNECTION BLOCK
// ====================================================================================

    datasource db {

      provider = "postgresql"     //    database management system being used (e.g., postgresql, mysql, sqlite, mongodb)
    }

// ====================================================================================
// PRISMA CLIENT GENERATOR BLOCK
// ====================================================================================

generator client {
  provider = "prisma-client-js" // Prisma ORM should generate types and methods for JavaScript/TypeScript
}

// ========================================================
// Database tables from here
// ========================================================


model User {
  id               String   @id @default(uuid())
  firstName        String
  lastName         String
  email            String   @unique
  isNewsletterSub  Boolean  @default(true)  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt       
}